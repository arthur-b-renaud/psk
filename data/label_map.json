{
  "version": 1,
  "comment": "Collapses source-corpus PII taxonomies down to the narrow PSK NER set. Targets are lowercase to match the gline-rs inference labels. Anything mapped to 'O' is dropped from NER training (handled by the regex/secrets layers instead). Unknown source labels fall back to 'O' and are logged by build_dataset.py.",
  "target_labels": ["organization", "person", "location", "address"],
  "fallback": "O",
  "map": {
    "ORGANIZATION": "organization",
    "ORGANIZATIONNAME": "organization",
    "ORG": "organization",
    "COMPANY": "organization",
    "COMPANYNAME": "organization",

    "GIVENNAME": "person",
    "FIRSTNAME": "person",
    "MIDDLENAME": "person",
    "SURNAME": "person",
    "LASTNAME": "person",
    "NAME": "person",
    "FULLNAME": "person",
    "USERNAME": "O",

    "CITY": "location",
    "STATE": "location",
    "COUNTY": "location",
    "COUNTRY": "location",
    "PROVINCE": "location",
    "NEARBYGPSCOORDINATE": "location",

    "STREET": "address",
    "STREETADDRESS": "address",
    "BUILDINGNUM": "address",
    "BUILDINGNUMBER": "address",
    "SECONDARYADDRESS": "address",
    "FULLADDRESS": "address",
    "ZIPCODE": "address",

    "TITLE": "O",
    "DATE": "O",
    "TIME": "O",
    "DOB": "O",
    "AGE": "O",
    "SEX": "O",
    "GENDER": "O",
    "ETHNICITY": "O",
    "EMAIL": "O",
    "TELEPHONENUM": "O",
    "PHONENUMBER": "O",
    "CREDITCARDNUMBER": "O",
    "DRIVERLICENSENUM": "O",
    "IDCARDNUM": "O",
    "PASSPORTNUM": "O",
    "SOCIALNUM": "O",
    "TAXNUM": "O",
