    "IPV6": "O",
    "MAC": "O",
    "URL": "O",
    "PASSWORD": "O",
    "PIN": "O",
    "VEHICLEVIN": "O",
    "VEHICLEVRM": "O",
    "AMOUNT": "O",
    "CURRENCY": "O",
    "CURRENCYSYMBOL": "O",
